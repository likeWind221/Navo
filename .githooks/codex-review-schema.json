{
  "type": "object",
  "properties": {
    "reviewTitle": {
      "type": "string",
      "description": "概括本次提交内容的简短中文标题，不含提交 SHA 或阶段名称"
    },
    "developmentStage": {
      "type": "string",
      "description": "项目所处阶段，格式为：阶段 N：阶段名称"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "enum": [
              "bug",
              "security",
              "performance",
              "reliability",
              "code-quality",
              "docs-contract",
              "test-gap",
              "accidental-change"
            ]
          },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "problem": { "type": "string" },
          "impact": { "type": "string" },
          "suggestion": { "type": "string" }
        },
        "required": [
          "severity",
          "category",
          "title",
          "file",
          "line",
          "problem",
          "impact",
          "suggestion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["reviewTitle", "developmentStage", "findings"],
  "additionalProperties": false
}
