#!/bin/sh

# 对每个完成的提交执行只读 Codex review。报告是建议性的：不会修改、
# 拒绝或重写提交。结果以中文 Markdown 写入可版本化的 _docs/codex-reviews/。

commit_sha="$(git rev-parse HEAD 2>/dev/null)" || exit 0
short_commit="$(git rev-parse --short=7 HEAD 2>/dev/null)" || exit 0
commit_subject="$(git log -1 --format=%s "$commit_sha" 2>/dev/null)" || exit 0
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" || exit 0
review_dir="$repo_root/_docs/codex-reviews"
report_file="$review_dir/未识别阶段--审查失败--$short_commit.md"
result_file="$review_dir/.result-$commit_sha-$$.json"
debug_file="$review_dir/.debug-$commit_sha-$$.tmp"
schema_file="$hook_dir/codex-review-schema.json"
renderer_file="$hook_dir/render-codex-review.mjs"
codex_command="$(command -v codex 2>/dev/null || true)"
review_prompt="只审查 Git 提交 $commit_sha。忽略工作区中尚未提交的改动，不要修改文件。

最终答案必须使用简体中文。像严格的代码审查工具一样，只报告值得开发者处理的具体发现，包括：
- 确定的 Bug、行为回归、边界条件或并发/时序问题；
- 安全、隐私、性能、可靠性和可维护性问题；
- 实现与提交说明、PRD、开发计划或公开契约之间的不一致；
- 有明确失败路径的错误处理风险、测试缺口或意外改动。

不要报告纯粹的格式、命名或个人偏好，也不要提出没有具体失败场景的泛泛重构建议。每个发现必须由本次提交引入，需给出准确位置、触发条件、实际影响和可执行的最小修复建议。

严重程度只能使用：
- High：可导致安全漏洞、数据丢失或损坏、主要功能不可用、普遍崩溃或大范围回归，合并前必须修复；
- Medium：合理使用下会触发的功能错误、可靠性问题、兼容性退化，或有较高概率导致后续维护问题，应尽快修复；
- Low：有具体证据的改进点，修复能降低实际风险，但不会阻塞主要流程。

category 只能使用 bug、security、performance、reliability、code-quality、docs-contract、test-gap、accidental-change。若没有值得处理的发现，返回空 findings，不要用提交摘要、测试过程或优点凑数。

reviewTitle 必须是概括本次提交内容的简短中文标题，不包含 SHA 或阶段名称。
同时根据本次提交、_docs/00-skillworld-prd.md、_docs/backend-plan.md 和 _docs/frontend-plan.md 判断 developmentStage，使用“阶段 N：阶段名称”格式；如果只涉及某个阶段的修改，优先使用该阶段。"

# GUI Git 客户端的 PATH 可能比终端更小；找不到命令时，尝试 Codex Desktop
# 的版本化安装目录，并选取最新的 codex.exe。
if [ -z "$codex_command" ]; then
  codex_root=""
  if [ -n "${LOCALAPPDATA:-}" ] && command -v cygpath >/dev/null 2>&1; then
    codex_root="$(cygpath -u "$LOCALAPPDATA")/OpenAI/Codex/bin"
  elif [ -n "${USERPROFILE:-}" ] && command -v cygpath >/dev/null 2>&1; then
    codex_root="$(cygpath -u "$USERPROFILE")/AppData/Local/OpenAI/Codex/bin"
  elif [ -n "${HOME:-}" ]; then
    codex_root="$HOME/AppData/Local/OpenAI/Codex/bin"
  fi

  if [ -d "$codex_root" ]; then
    for candidate in "$codex_root"/*/codex.exe; do
      [ -f "$candidate" ] || continue
      if [ -z "$codex_command" ] || [ "$candidate" -nt "$codex_command" ]; then
        codex_command="$candidate"
      fi
    done
  fi
fi

if ! mkdir -p "$review_dir"; then
  printf '\n[Codex 审查] 无法创建报告目录：%s\n' "$review_dir" >&2
  exit 0
fi

trap 'rm -f "$result_file" "$debug_file"' EXIT HUP INT TERM

if [ -z "$codex_command" ] || [ ! -f "$codex_command" ]; then
  printf '# Git Commit %s（%s）— 开发阶段识别失败\n\n未在 PATH 或 Codex Desktop 安装目录中找到 Codex CLI，无法执行审查。\n' \
    "$short_commit" "$commit_subject" | tee "$report_file"
elif ! command -v node >/dev/null 2>&1; then
  printf '# Git Commit %s（%s）— 开发阶段识别失败\n\n未在 PATH 中找到 Node.js，无法渲染审查报告。\n' \
    "$short_commit" "$commit_subject" | tee "$report_file"
elif [ ! -f "$schema_file" ] || [ ! -f "$renderer_file" ]; then
  printf '# Git Commit %s（%s）— 开发阶段识别失败\n\n审查所需的 Schema 或渲染脚本缺失，无法生成报告。\n' \
    "$short_commit" "$commit_subject" | tee "$report_file"
else
  (
    cd "$repo_root" || exit 1
    "$codex_command" exec --ephemeral --sandbox read-only --output-schema "$schema_file" \
      -o "$result_file" "$review_prompt" > /dev/null 2> "$debug_file"
  )
  review_status=$?
  if [ "$review_status" -eq 0 ] && [ -s "$result_file" ]; then
    report_file="$(
      cd "$repo_root" || exit 1
      node "$renderer_file" "$result_file" "$review_dir" \
        "$commit_sha" "$commit_subject"
    )"
    render_status=$?
    if [ "$render_status" -eq 0 ]; then
      cat "$report_file"
    else
      report_file="$review_dir/未识别阶段--渲染失败--$short_commit.md"
      printf '# Git Commit %s（%s）— 开发阶段识别失败\n\n审查结果渲染失败，请手动重试。\n' \
        "$short_commit" "$commit_subject" | tee "$report_file"
    fi
  elif [ "$review_status" -eq 0 ]; then
    report_file="$review_dir/未识别阶段--空审查结果--$short_commit.md"
    printf '# Git Commit %s（%s）— 开发阶段识别失败\n\nCodex 未返回可渲染的审查结果，请手动重试。\n' \
      "$short_commit" "$commit_subject" | tee "$report_file"
  fi
  rm -f "$result_file" "$debug_file"
  if [ "$review_status" -ne 0 ]; then
    printf '# Git Commit %s（%s）— 开发阶段识别失败\n\n[Codex 审查] 审查进程以状态码 %s 退出；Commit 不受影响，请手动重试。\n' \
      "$short_commit" "$commit_subject" "$review_status" | tee "$report_file"
  fi
fi

printf '\n[Codex 审查] 本次提交的报告已保存：%s\n' "$report_file"
exit 0
