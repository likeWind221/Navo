{
  "name": "navo",
  "version": "0.0.0",
  "private": true,
  "description": "An adaptive long-horizon agent framework for planning, execution, verification, and replanning.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "host": "tsx src/host/main.ts",
    "host:mock": "tsx scripts/host/mock.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:real": "tsx scripts/real.ts"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "1.0.67",
    "cordis": "4.0.0-rc.9",
    "ipaddr.js": "2.5.0",
    "turndown": "7.2.4",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/turndown": "5.0.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
